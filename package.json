{
  "name": "wp-site-biz",
  "version": "0.4.6",
  "description": "Webpack small business website initial project ☀️",
  "main": "webpack.config.js",
  "scripts": {
    "build": "npm run autogen:newslist && npm run build:webpack",
    "build:webpack": "export NODE_OPTIONS=--openssl-legacy-provider && webpack --config webpack.config.js && export NODE_OPTIONS=",
    "autogen:newslist": "python3 src/jsons/news/autogen_news_list.py",
    "start": "nodemon app.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "start:dev": "export NODE_OPTIONS=--openssl-legacy-provider && webpack-dev-server --open && export NODE_OPTIONS=",
    "version:minor": "npm version minor --no-git-tag-version --no-commit-hooks",
    "version:patch": "npm version patch --no-git-tag-version --no-commit-hooks"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "babel-loader": "^8.4.1",
    "babel-plugin-syntax-dynamic-import": "^6.18.0",
    "html-webpack-plugin": "^4.5.2",
    "nodemon": "^3.1.7",
    "pug-loader": "^2.4.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyslab/wp-site-biz.git"
  },
  "keywords": [
    "webpack@4",
    "biz",
    "website"
  ],
  "author": "DYSLAB",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dyslab/wp-site-biz/issues"
  },
  "homepage": "https://github.com/dyslab/wp-site-biz#readme"
}
